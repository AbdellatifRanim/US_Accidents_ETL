                          name="FriendlyExpression">ISNULL(Weather_Clean) || Weather_Clean == "" ? "Inconnu" : (FINDSTRING(LOWER(Weather_Clean),"rain",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"drizzle",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"showers",1) &gt; 0) ? "Pluie" : (FINDSTRING(LOWER(Weather_Clean),"snow",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"sleet",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"wintry",1) &gt; 0) ? "Neige" : (FINDSTRING(LOWER(Weather_Clean),"storm",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"thunder",1) &gt; 0) ? "Orage" : (FINDSTRING(LOWER(Weather_Clean),"fog",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"mist",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"haze",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"smoke",1) &gt; 0) ? "Brouillard" : (FINDSTRING(LOWER(Weather_Clean),"cloud",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"overcast",1) &gt; 0) ? "Nuageux" : (FINDSTRING(LOWER(Weather_Clean),"clear",1) &gt; 0 || FINDSTRING(LOWER(Weather_Clean),"fair",1) &gt; 0) ? "Clair" : "Autre"</property>
